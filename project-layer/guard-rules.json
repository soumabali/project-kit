{
  "description": "Commands the project-kit command guard (scripts/hooks/pre-tool.mjs) watches in project-kit projects. Patterns use permission-rule syntax: * matches anything, and a trailing ' *' also matches the bare command; matching ignores case (a pattern that starts with 'case:' keeps it) and runs on every simple command in a chain, subshell, eval, or sh -c string, also behind sudo, env, or xargs. Quoted text in a commit message, a gh body, or an echo is not matched. In guarded autonomy both lists ask before running. In auto autonomy, 'ask' runs without a prompt and 'unattended' (printing secrets, changing remote infrastructure, publishing, deploying, merging) is denied, because nobody is there to check what they print or change.",
  "ask": [
    "git push *",
    "git reset --hard*",
    "git clean *",
    "case:git branch -D *",
    "git branch *--delete*--force*",
    "git branch *--force*--delete*",
    "git stash clear*",
    "git checkout -- *",
    "git checkout .",
    "git restore .",
    "find *-delete*",
    "dropdb *",
    "rm -rf *",
    "rm -fr *",
    "rm -r -f *",
    "Remove-Item *-Recurse*",
    "*migrate:fresh*",
    "*migrate:reset*",
    "*migrate:refresh*",
    "*migrate:rollback*",
    "*db:wipe*",
    "*db:drop*",
    "*db:reset*",
    "*db:rollback*",
    "*db:schema:load*",
    "*manage.py flush*",
    "*prisma migrate reset*",
    "*--force-reset*",
    "*ef database drop*",
    "*flyway clean*",
    "*liquibase drop-all*",
    "*sqlx database drop*",
    "*sqlx database reset*",
    "*down -v*",
    "*down --volumes*",
    "*docker volume rm*",
    "*docker volume prune*",
    "*docker system prune*"
  ],
  "unattended": [
    "env",
    "printenv*",
    "set",
    "Get-ChildItem *env:*",
    "gci *env:*",
    "dir *env:*",
    "ls env:*",
    "*compose config*",
    "*config:show*",
    "*credentials:show*",
    "*secrets:reveal*",
    "*kubectl get secret*",
    "*get-secret-value*",
    "*terraform apply*",
    "*terraform destroy*",
    "*tofu apply*",
    "*tofu destroy*",
    "*kubectl delete*",
    "*helm uninstall*",
    "npm publish*",
    "pnpm publish*",
    "yarn publish*",
    "yarn npm publish*",
    "cargo publish*",
    "gem push *",
    "twine upload*",
    "gh pr merge*",
    "gh release create*",
    "*vercel deploy*",
    "*vercel *--prod*",
    "*netlify deploy*",
    "*firebase deploy*",
    "*wrangler deploy*",
    "*wrangler publish*",
    "fly deploy*",
    "flyctl deploy*"
  ]
}
