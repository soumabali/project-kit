{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "Read(.env)",
      "Read(.env.*)",
      "Read(.envrc)",
      "Read(.dev.vars*)",
      "Read(*.pem)",
      "Read(*.key)",
      "Read(*.p8)",
      "Read(*.p12)",
      "Read(*.pfx)",
      "Read(*.keystore)",
      "Read(*.jks)",
      "Read(key.properties)",
      "Read(id_rsa*)",
      "Read(id_ed25519*)",
      "Read(*.tfstate)",
      "Read(*.tfstate.*)",
      "Read(secrets/**)",
      "Read(**/credentials*.json)",
      "Read(**/service-account*.json)",
      "Read(~/.ssh/**)",
      "Read(~/.aws/**)",
      "Read(~/.config/gcloud/**)",
      "Read(~/.kube/**)",
      "Read(~/.docker/config.json)",
      "Read(~/.npmrc)",
      "Read(~/.netrc)",
      "Read(~/.git-credentials)",
      "Read(~/.pypirc)",
      "Read(~/.cargo/credentials*)",
      "Read(~/.composer/auth.json)",
      "Read(~/.config/composer/auth.json)",
      "Bash(git commit *--no-verify*)",
      "Bash(git commit -n*)",
      "Bash(git push *--no-verify*)",
      "Bash(git push *--force*)",
      "Bash(git push -f*)",
      "Bash(git push * -f*)",
      "Bash(git push * +*)",
      "Bash(git -c core.hooksPath*)",
      "Read(!.env.example)"
    ]
  }
}
