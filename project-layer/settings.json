{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "Read(.env)",
      "Read(.env.*)",
      "Read(.envrc)",
      "Read(.dev.vars*)",
      "Read(*.pem)",
      "Read(*.key)",
      "Read(*.p8)",
      "Read(*.p12)",
      "Read(*.pfx)",
      "Read(*.keystore)",
      "Read(*.jks)",
      "Read(key.properties)",
      "Read(id_rsa*)",
      "Read(id_ed25519*)",
      "Read(*.tfstate)",
      "Read(*.tfstate.*)",
      "Read(secrets/**)",
      "Read(**/credentials*.json)",
      "Read(**/service-account*.json)",
      "Read(~/.ssh/**)",
      "Read(~/.aws/**)",
      "Read(~/.config/gcloud/**)",
      "Read(~/.kube/**)",
      "Read(~/.docker/config.json)",
      "Read(~/.npmrc)",
      "Read(~/.netrc)",
      "Read(~/.git-credentials)",
      "Read(~/.pypirc)",
      "Read(~/.cargo/credentials*)",
      "Read(~/.composer/auth.json)",
      "Read(~/.config/composer/auth.json)",
      "Bash(git commit *--no-verify*)",
      "Bash(git commit -n*)",
      "Bash(git push *--no-verify*)",
      "Bash(git push *--force*)",
      "Bash(git push -f*)",
      "Bash(git push * -f*)",
      "Bash(git push * +*)",
      "Bash(git -c core.hooksPath*)",
      "Read(!.env.example)"
    ],
    "ask": [
      "Bash(git push *)",
      "Bash(git -C *)",
      "Bash(git commit * -n *)",
      "Bash(git commit * -n)",
      "Bash(*HUSKY=0*)",
      "Bash(git reset --hard*)",
      "Bash(git clean *)",
      "Bash(git branch -D *)",
      "Bash(git stash clear*)",
      "Bash(rm -rf *)",
      "Bash(rm -fr *)",
      "Bash(*migrate:fresh*)",
      "Bash(*migrate:reset*)",
      "Bash(*migrate:refresh*)",
      "Bash(*migrate:rollback*)",
      "Bash(*db:wipe*)",
      "Bash(*db:drop*)",
      "Bash(*db:reset*)",
      "Bash(*db:rollback*)",
      "Bash(*db:schema:load*)",
      "Bash(*manage.py flush*)",
      "Bash(*prisma migrate reset*)",
      "Bash(*--force-reset*)",
      "Bash(*ef database drop*)",
      "Bash(*flyway clean*)",
      "Bash(*liquibase drop-all*)",
      "Bash(*down -v*)",
      "Bash(*down --volumes*)",
      "Bash(*docker volume rm*)",
      "Bash(*docker volume prune*)",
      "Bash(*docker system prune*)",
      "Bash(*terraform apply*)",
      "Bash(*terraform destroy*)",
      "Bash(*kubectl delete*)",
      "Bash(env)",
      "Bash(printenv*)",
      "Bash(*compose config*)",
      "Bash(*config:show*)",
      "Bash(*credentials:show*)",
      "Bash(*secrets:reveal*)",
      "Bash(*kubectl get secret*)",
      "Bash(*get-secret-value*)"
    ]
  }
}
